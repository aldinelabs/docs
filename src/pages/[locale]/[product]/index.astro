---
import { locales, type Locale } from '@aldine/ui/i18n';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import { button } from '@aldine/ui/ui';
import { docUrl, getDocs, treeOf } from '../../../lib/docs';
import { ui } from '../../../lib/strings';
import { products } from '../../../products';

export function getStaticPaths() {
	return locales.flatMap((locale) => Object.keys(products).map((product) => ({ params: { locale, product } })));
}

const { locale, product } = Astro.params as { locale: Locale; product: string };
const info = products[product];
const tree = treeOf(await getDocs(), product, locale);
const text = ui[locale];
const first = tree[0]?.doc;
---

<DocsLayout title={info.name} description={info.description[locale]} product={product}>
	<h1 class="mb-3 text-4xl font-medium tracking-tight">{info.name}</h1>
	<p class="max-w-2xl text-xl text-muted-foreground">{info.description[locale]}</p>
	{
		first && (
			<a href={docUrl(locale, product, first.slug)} class:list={[button.primary, 'mt-8 h-10 px-5 text-base']}>
				{text.startHere}
				<ArrowRight class="size-4" aria-hidden="true" />
			</a>
		)
	}

	<div class="mt-12 flex flex-col gap-12">
		{
			tree.map(({ doc, children }) => (
				<section aria-labelledby={`group-${doc.slug}`}>
					<h2 id={`group-${doc.slug}`} class="text-2xl font-medium tracking-tight">
						<a href={docUrl(locale, product, doc.slug)} class="hover:underline hover:underline-offset-4">
							{doc.title}
						</a>
					</h2>
					<p class:list={['mt-1.5 text-base text-muted-foreground', children.length > 0 && 'mb-5']}>{doc.description}</p>
					{children.length > 0 && (
					<ul class="divide-y overflow-hidden rounded-2xl border">
						{children.map((child) => (
							<li>
								<a href={docUrl(locale, product, child.slug)} class="group flex items-center gap-4 px-5 py-4 outline-none transition-colors hover:bg-accent focus-visible:bg-accent">
									<span class="min-w-0 flex-1">
										<span class="block text-base font-medium">{child.title}</span>
										<span class="mt-1 block text-[0.9375rem] leading-snug text-muted-foreground">{child.description}</span>
									</span>
									<ChevronRight class="size-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
								</a>
							</li>
						))}
					</ul>
					)}
				</section>
			))
		}
	</div>
</DocsLayout>
