---
import { defaultLocale, locales } from '@aldine/ui/i18n';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta http-equiv="refresh" content={`0;url=/${defaultLocale}/`} />
		<link rel="canonical" href={`/${defaultLocale}/`} />
		<meta name="robots" content="noindex" />
		<title>Aldine Docs</title>
		<script is:inline define:vars={{ supported: locales, fallback: defaultLocale }}>
			// Send the visitor to the language they chose before, or the first supported language in their browser.
			(() => {
				let choice = null;
				try {
					choice = localStorage.getItem('locale');
				} catch {}
				if (!supported.includes(choice)) {
					choice = fallback;
					for (const tag of navigator.languages || [navigator.language]) {
						const base = String(tag).toLowerCase().split('-')[0];
						if (supported.includes(base)) {
							choice = base;
							break;
						}
					}
				}
				location.replace(`/${choice}/${location.search}${location.hash}`);
			})();
		</script>
	</head>
	<body>
		<p><a href={`/${defaultLocale}/`}>Aldine Docs</a></p>
	</body>
</html>
